# Variables de entorno del sistema.
# Copia este archivo como ".env" y ajusta los valores.

# ── Base de datos ────────────────────────────────────────────────────────────
# PostgreSQL (local o AWS RDS):
SCHEDULER_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/scheduler
# RDS: postgresql+psycopg://user:password@<endpoint>:5432/scheduler

# Base de datos usada por los tests de integración (se crean/borran las tablas):
# SCHEDULER_TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/scheduler_test

# ── Seguridad ────────────────────────────────────────────────────────────────
SCHEDULER_SECRET_KEY=generate-with-openssl-rand-hex-32

# ── General ──────────────────────────────────────────────────────────────────
SCHEDULER_LOG_LEVEL=INFO
SCHEDULER_DEBUG=false
