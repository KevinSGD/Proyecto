# Variables de entorno del sistema.
# Copia este archivo como ".env" y ajusta los valores.

# ── Base de datos ────────────────────────────────────────────────────────────
# SQLite (desarrollo local — no requiere servidor):
SCHEDULER_DATABASE_URL=sqlite:///scheduler.db

# PostgreSQL (producción):
# SCHEDULER_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/scheduler

# ── Seguridad ────────────────────────────────────────────────────────────────
SCHEDULER_SECRET_KEY=generate-with-openssl-rand-hex-32

# ── General ──────────────────────────────────────────────────────────────────
SCHEDULER_LOG_LEVEL=INFO
SCHEDULER_DEBUG=false
