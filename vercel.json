{
  "version": 2,
  "builds": [
    {
      "src": "proyecto/horarios_universidad/frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "buildCommand": "cd proyecto/horarios_universidad/frontend && npm install && npm run build",
  "outputDirectory": "proyecto/horarios_universidad/frontend/dist",
  "rewrites": [
    {
      "source": "(.*)",
      "destination": "/index.html"
    }
  ]
}